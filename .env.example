# Copy to .env and fill in the keys for the providers you use.
# Inspect reads this file from the directory you run `inspect eval` in.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint, used as openai-api/<service>/<model>.
# Example for --model-role target=openai-api/deepseek/deepseek-v4-pro:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
